# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string. In production (Vercel), set this to the
# pooled connection string from your Postgres provider (e.g. Vercel Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/street_smart?schema=public"

# Seeded admin account (see prisma/seed.ts). Change the password after first login.
SEED_ADMIN_EMAIL="admin@streetsmart.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
